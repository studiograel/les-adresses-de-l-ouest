---
// Carte des lieux de tournage : LEUR carte (reference/carte-lieux.png, droits confirmés oralement par Matteo le 03/10/2026),
// présentée comme une infographie de presse. Aucune bibliothèque de carte, aucune tuile, aucun iframe, aucune ressource tierce.
// Les pins sont de vrais <button> posés SUR l'image, en CSS, en pourcentage (x, y) à partir de src/data/lieux.js.
// Seuls les lieux avec accordAffichage: true sont montrés. Aucune position n'est devinée.
import carte from '../assets/carte-lieux.webp';
import { lieux } from '../data/lieux.js';
import { regrouper } from '../utils/carte.js';

// Sur un petit téléphone (environ 340 px de carte), deux pins doivent rester à 44 px l'un de l'autre.
// Les pins plus proches sont regroupés en un seul (avec un nombre), dont la fiche liste les lieux.
const LARGEUR_MOBILE = 340;
const hauteurMobile = (LARGEUR_MOBILE * carte.height) / carte.width;

// 1. Seuls les lieux dont l'accord pour être cités sur le site est confirmé sont affichés.
const affiches = lieux.filter((l) => l.accordAffichage === true && l.nom && l.commune);

// 2. Position sur l'image : x et y doivent être des pourcentages valides, sinon le lieu est listé sans pin.
const enPourcent = (v) => typeof v === 'number' && v >= 0 && v <= 100;
const positionnes = [];
const sansPosition = [];
for (const lieu of affiches) {
  if (enPourcent(lieu.x) && enPourcent(lieu.y)) {
    positionnes.push(lieu);
  } else {
    sansPosition.push(lieu);
    console.warn(`[carte] « ${lieu.nom} » : x et y absents ou hors carte, aucun pin. [À CONFIRMER : position de ${lieu.nom}]`);
  }
}

const groupes = regrouper(positionnes, 44, LARGEUR_MOBILE, hauteurMobile).map((g, i) => ({
  ...g,
  id: `fiche-${i + 1}`,
  unique: g.lieux.length === 1,
}));

// 3. Liste en texte regroupée par commune (alternative lisible sans JavaScript, utile au référencement local)
const parCommune = new Map();
for (const lieu of affiches) {
  if (!parCommune.has(lieu.commune)) parCommune.set(lieu.commune, []);
  parCommune.get(lieu.commune).push(lieu);
}
const communes = [...parCommune.entries()]
  .sort(([a], [b]) => a.localeCompare(b, 'fr'))
  .map(([commune, liste]) => [commune, liste.sort((a, b) => a.nom.localeCompare(b.nom, 'fr'))]);

// Le nombre d'adresses est calculé à partir de la liste affichée, jamais écrit à la main.
const nombre = affiches.length;
---

<section id="carte" class="rubrique carte" aria-labelledby="titre-carte">
  <div class="conteneur">
    <header class="rubrique__entete">
      <p class="surtitre">Les lieux</p>
      <h2 id="titre-carte">Les adresses où nous avons tourné</h2>
    </header>

    <div class="carte__grille">
      <div class="carte__texte">
        {
          nombre > 0 ? (
            <p class="chapeau">
              {nombre} adresse{nombre > 1 ? 's' : ''} où une vidéo a été tournée, à retrouver sur la carte et dans la
              liste par commune.
            </p>
          ) : (
            <p>
              <span class="a-confirmer">[À CONFIRMER : liste des lieux de tournage à recevoir de Léane]</span>
            </p>
          )
        }
      </div>

      <figure class="infographie" data-carte>
        <p class="infographie__titre petites-capitales">Carte des lieux de tournage</p>
        <div class="carte__cadre" style={`aspect-ratio: ${carte.width} / ${carte.height}`}>
          <img
            class="carte__image"
            src={carte.src}
            width={carte.width}
            height={carte.height}
            alt="Carte de l'Ouest lyonnais indiquant les communes où Les Adresses de l'Ouest ont tourné des vidéos"
            loading="lazy"
            decoding="async"
          />
          {
            groupes.map((g) => {
              const premier = g.lieux[0];
              const nomAccessible = g.unique
                ? `${premier.nom}, ${premier.commune}`
                : `${g.lieux.length} adresses : ${g.lieux.map((l) => `${l.nom} (${l.commune})`).join(', ')}`;
              const dessous = g.y < 50;
              return (
                <>
                  <button
                    type="button"
                    class:list={['pin', { 'pin--groupe': !g.unique }]}
                    style={`--x:${g.x}%;--y:${g.y}%`}
                    aria-label={nomAccessible}
                    aria-expanded="false"
                    aria-controls={g.id}
                  >
                    <span class="pin__disque" aria-hidden="true">{!g.unique && g.lieux.length}</span>
                  </button>
                  <div
                    id={g.id}
                    class:list={['fiche', dessous ? 'fiche--dessous' : 'fiche--dessus']}
                    style={`--x:${g.x}%;--y:${g.y}%`}
                    hidden
                  >
                    {g.lieux.map((l) => (
                      <div class="fiche__lieu">
                        <p class="fiche__nom">{l.nom}</p>
                        <p class="fiche__commune">{l.commune}</p>
                        {l.lien && (
                          <a href={l.lien} target="_blank" rel="noopener" referrerpolicy="no-referrer">
                            En savoir plus<span class="sr-only"> sur {l.nom} (s'ouvre dans un nouvel onglet)</span>
                          </a>
                        )}
                      </div>
                    ))}
                  </div>
                </>
              );
            })
          }
        </div>
        <figcaption class="infographie__legende">
          <span>Les pins signalent les adresses où une vidéo a été tournée.</span>
          <span class="infographie__source petites-capitales">Carte : Les Adresses de l'Ouest</span>
        </figcaption>
      </figure>
    </div>

    {
      nombre > 0 && (
        <div class="carte__liste">
          {communes.map(([commune, liste]) => (
            <section class="carte__commune" aria-labelledby={`commune-${commune}`}>
              <h3 id={`commune-${commune}`}>{commune}</h3>
              <ul>
                {liste.map((l) => (
                  <li>
                    {l.lien ? (
                      <a href={l.lien} target="_blank" rel="noopener" referrerpolicy="no-referrer">
                        {l.nom}
                        <span class="sr-only"> (s'ouvre dans un nouvel onglet)</span>
                      </a>
                    ) : (
                      l.nom
                    )}
                    {sansPosition.includes(l) && <span class="a-confirmer">[À CONFIRMER : position de {l.nom}]</span>}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )
    }
  </div>

  {
    groupes.length > 0 && (
      <script is:inline>
        // Fiche d'un pin : s'ouvre au clic, au toucher ou au clavier ; Échap ou un clic ailleurs la ferme.
        (function () {
          var pins = document.querySelectorAll('[data-carte] .pin');
          function fermer() {
            pins.forEach(function (p) { p.setAttribute('aria-expanded', 'false'); document.getElementById(p.getAttribute('aria-controls')).hidden = true; });
          }
          pins.forEach(function (p) {
            p.addEventListener('click', function () {
              var fiche = document.getElementById(p.getAttribute('aria-controls'));
              var ouvrir = fiche.hidden;
              fermer();
              if (ouvrir) { fiche.hidden = false; p.setAttribute('aria-expanded', 'true'); }
            });
          });
          document.addEventListener('click', function (e) { if (!e.target.closest('.pin, .fiche')) fermer(); });
          document.addEventListener('keydown', function (e) {
            if (e.key !== 'Escape') return;
            var ouvert = document.querySelector('[data-carte] .pin[aria-expanded="true"]');
            fermer();
            if (ouvert) ouvert.focus();
          });
        })();
      </script>
    )
  }
</section>
