---
// Bandeau de titre du journal : le logo, la devise, les communes, un double filet (trait épais bleu, trait fin dessous),
// puis la ligne de date en petites capitales.
// La navigation par rubriques n'est plus ici : c'est le « Sommaire » de la une (index.astro) qui la remplace.
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site } from '../data/site.js';
---

<header class="entete">
  <div class="conteneur">
    <div class="entete__titre">
      <a class="entete__logo" href="/">
        <Image
          src={logo}
          alt="Les Adresses de l'Ouest, retour à l'accueil. Logo : un rond crème au liseré orange, le nom en bleu marine et des silhouettes d'immeubles lyonnais en orange."
          width={120}
          height={120}
          densities={[1, 2]}
          format="webp"
          loading="eager"
        />
      </a>
      <div class="entete__devise">
        <p class="entete__signature">{site.signature}</p>
        <ul class="entete__communes petites-capitales" aria-label="Communes">
          {site.communes.map((commune) => <li>{commune}</li>)}
        </ul>
      </div>
    </div>

    <div class="filet-double" aria-hidden="true"></div>

    <!-- Sans JavaScript : « Ouest lyonnais ». Avec : la vraie date du jour du visiteur (heure de Paris), jamais une date inventée. -->
    <p class="entete__date petites-capitales" id="date-du-jour">Ouest lyonnais</p>
  </div>

  <script is:inline>
    (function () {
      var ligne = document.getElementById('date-du-jour');
      if (!ligne || !window.Intl) return;
      ligne.textContent = new Intl.DateTimeFormat('fr-FR', {
        timeZone: 'Europe/Paris',
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
      }).format(new Date());
    })();
  </script>
</header>
