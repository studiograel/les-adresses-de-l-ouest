---
// Bandeau de titre du journal : le logo, la devise, les communes, un double filet (trait épais bleu, trait fin dessous),
// puis la ligne de rubriques en petites capitales, qui sert de navigation par ancres.
// Sur mobile, la ligne de rubriques devient un menu <details> : de l'HTML et du CSS, aucun JavaScript.
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site } from '../data/site.js';

const rubriques = [
  { href: '/#concept', texte: 'Le projet' },
  { href: '/#pourquoi', texte: 'Pourquoi' },
  { href: '/#offre', texte: "L'offre" },
  { href: '/#carte', texte: 'Les lieux' },
  { href: '/#accompagnement', texte: 'Aller plus loin' },
];
---

<header class="entete">
  <div class="conteneur">
    <div class="entete__titre">
      <a class="entete__logo" href="/">
        <Image
          src={logo}
          alt="Les Adresses de l'Ouest, retour à l'accueil. Logo : un rond crème au liseré orange, le nom en bleu marine et des silhouettes d'immeubles lyonnais en orange."
          width={120}
          height={120}
          densities={[1, 2]}
          format="webp"
          loading="eager"
        />
      </a>
      <div class="entete__devise">
        <p class="entete__signature">{site.signature}</p>
        <ul class="entete__communes petites-capitales" aria-label="Communes">
          {site.communes.map((commune) => <li>{commune}</li>)}
        </ul>
      </div>
    </div>

    <div class="filet-double" aria-hidden="true"></div>

    <nav class="rubriques petites-capitales" aria-label="Rubriques">
      <ul class="rubriques__liste">
        {
          rubriques.map((rubrique) => (
            <li>
              <a class="rubriques__lien" href={rubrique.href}>
                {rubrique.texte}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="menu">
      <summary class="menu__bouton petites-capitales">
        <span>Menu</span>
        <svg class="menu__icone" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" focusable="false">
          <rect x="1" y="4" width="20" height="2"></rect>
          <rect x="1" y="10" width="20" height="2"></rect>
          <rect x="1" y="16" width="20" height="2"></rect>
        </svg>
      </summary>
      <nav aria-label="Rubriques">
        <ul class="menu__liste petites-capitales">
          {
            rubriques.map((rubrique) => (
              <li>
                <a href={rubrique.href}>{rubrique.texte}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
