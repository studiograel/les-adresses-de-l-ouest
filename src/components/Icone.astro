---
// Icônes dessinées en ligne (SVG), un seul trait et une seule épaisseur. Jamais d'emoji.
// Décoratives : cachées des lecteurs d'écran (le texte voisin porte le sens).
interface Props {
  nom: keyof typeof formes;
  class?: string;
}

const formes = {
  'fleche-haut-droite': '<path d="M7 17 17 7"/><path d="M8 7h9v9"/>',
  'fleche-droite': '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  repere: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.5"/>',
  ecran: '<rect x="3" y="4" width="18" height="13" rx="1"/><path d="m8 10.5 2.7 2.7L16 8"/><path d="M8 21h8"/><path d="M12 17v4"/>',
  lecture: '<rect x="3" y="5" width="18" height="14" rx="1"/><path d="M10 9.5v5l4.5-2.5Z"/>',
  boussole: '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5Z"/>',
  horloge: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  camera: '<rect x="2.5" y="6" width="13" height="12" rx="1"/><path d="m15.5 10 6-3v10l-6-3"/>',
} as const;

const { nom, class: classe } = Astro.props;
---

<svg class:list={['icone', classe]} viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={formes[nom]} />
